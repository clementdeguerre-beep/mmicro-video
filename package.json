{
  "name": "mmicro-video",
  "version": "1.0.0",
  "private": true,
  "description": "Film de présentation en motion design pour MMICRO Multiservices (Remotion)",
  "type": "module",
  "scripts": {
    "captures": "node scripts/captures.mjs",
    "sons": "node --experimental-strip-types --no-warnings scripts/sons.mjs",
    "studio": "remotion studio",
    "storyboard": "node scripts/storyboard.mjs",
    "rendu": "node --experimental-strip-types --no-warnings scripts/rendu.mjs",
    "images": "node scripts/images-fixes.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "@remotion/cli": "4.0.531",
    "@remotion/media-utils": "4.0.531",
    "@remotion/motion-blur": "4.0.531",
    "@remotion/noise": "4.0.531",
    "@remotion/paths": "4.0.531",
    "@remotion/three": "4.0.531",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.531",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.180.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  }
}
